rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sécurité stricte pour forfait gratuit Spark
    // Profils utilisateurs : seul l'utilisateur authentifié peut lire et modifier ses propres données
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /favorites/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /stats/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Contenus publics en lecture seule (pas de modification client)
    match /public_content/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
